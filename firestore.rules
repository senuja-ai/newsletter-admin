rules_version = '2';

// Security rules for Nørre News.
// Paste this into Firebase console → Firestore Database → Rules → Publish.
// Replace the two emails below with your writers' login emails.

service cloud.firestore {
  match /databases/{database}/documents {

    function isWriter() {
      return request.auth != null
        && request.auth.token.email in [
          'senujaganganath@gmail.com',
          'yekta.shekari8821@gmail.com',
          'lenkachrenkova8@gmail.com',
          'febaknine@gmail.com'
        ];
    }

    function validPost() {
      let d = request.resource.data;
      return d.section in ['feature', 'news', 'events', 'spotlight', 'corner', 'gossip', 'quote']
        && d.title is string && d.title.size() <= 200
        && d.tag is string && d.tag.size() <= 60
        && d.date is string && d.date.size() <= 10
        && d.body is string && d.body.size() > 0 && d.body.size() <= 9000
        && d.published is bool;
    }

    match /posts/{postId} {
      // Anyone can read published posts; writers can also read drafts.
      allow read: if resource.data.published == true || isWriter();
      // Only the writers can create, edit or delete.
      allow create, update: if isWriter() && validPost();
      allow delete: if isWriter();
    }

    // ---------- Articles (full pages with comments) ----------
    function validArticle() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.subtitle is string && d.subtitle.size() <= 300
        && d.authorName is string && d.authorName.size() > 0 && d.authorName.size() <= 80
        && d.coverUrl is string && d.coverUrl.size() <= 500
        && d.body is string && d.body.size() > 0 && d.body.size() <= 900000
        && d.published is bool;
    }

    match /articles/{articleId} {
      // Anyone can read published articles; writers can also read drafts.
      allow read: if resource.data.published == true || isWriter();
      allow create, update: if isWriter() && validArticle();
      allow delete: if isWriter();

      match /comments/{commentId} {
        // Anyone can read comments and add one to a published article.
        allow read: if true;
        // A reply also stores which comment it belongs to (parentId) and who it answers (replyTo).
        allow create: if request.resource.data.keys().hasOnly(['name', 'text', 'createdAt', 'parentId', 'replyTo'])
          && request.resource.data.get('parentId', '') is string
          && request.resource.data.get('parentId', '').size() <= 40
          && request.resource.data.get('replyTo', '') is string
          && request.resource.data.get('replyTo', '').size() <= 50
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 50
          && request.resource.data.text is string
          && request.resource.data.text.size() > 1 && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time
          && get(/databases/$(database)/documents/articles/$(articleId)).data.published == true;
        // Nobody can edit a comment; only writers can delete them.
        allow update: if false;
        allow delete: if isWriter();
      }

      // Pictures uploaded on the Writers' Desk (stored as compressed image data).
      match /images/{imageId} {
        allow read: if isWriter()
          || get(/databases/$(database)/documents/articles/$(articleId)).data.published == true;
        allow create: if isWriter()
          && request.resource.data.type in ['image/webp', 'image/jpeg', 'image/png', 'image/gif']
          && request.resource.data.data is string
          && request.resource.data.data.size() < 1000000;
        allow update: if false;
        allow delete: if isWriter();
      }
    }

    // ---------- Letterbox: anonymous reports and article submissions ----------
    function validSubmission() {
      let d = request.resource.data;
      return d.keys().hasOnly(['type', 'title', 'name', 'body', 'imageCount', 'status', 'createdAt'])
        && d.type in ['report', 'article']
        && d.title is string && d.title.size() <= 200
        && d.name is string && d.name.size() <= 80
        && d.body is string && d.body.size() > 0 && d.body.size() <= 450000
        && d.imageCount is int && d.imageCount >= 0 && d.imageCount <= 10
        && d.status == 'new'
        && d.createdAt == request.time;
    }

    match /submissions/{subId} {
      // Anyone can send one; only the writers can read, update or delete them.
      allow create: if validSubmission();
      allow read, update, delete: if isWriter();

      // Pictures sent with a submission: only allowed in the first 10 minutes after it was sent.
      match /images/{imageId} {
        allow create: if request.resource.data.keys().hasOnly(['data', 'type'])
          && request.resource.data.type in ['image/webp', 'image/jpeg', 'image/png', 'image/gif']
          && request.resource.data.data is string
          && request.resource.data.data.size() < 1000000
          && request.time < get(/databases/$(database)/documents/submissions/$(subId)).data.createdAt + duration.value(10, 'm');
        allow read, delete: if isWriter();
      }
    }
  }
}
